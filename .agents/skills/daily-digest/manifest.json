{
  "name": "daily-digest",
  "version": "1.0.0",
  "description": "生成每日對話摘要、決策複盤與 Obsidian Vault 雙向同步的 Rust 內建技能",
  "author": "Honey2",
  "tags": ["daily", "digest", "obsidian", "sync", "automation"],
  "status": "draft",
  "created": "2026-11-02",
  "dependencies": [
    {"name": "buzz-agent", "version": "*", "path": "../../../crates/buzz-agent"},
    {"name": "buzz-core", "version": "*", "path": "../../../crates/buzz-core"},
    {"name": "anyhow", "version": "1.0"},
    {"name": "chrono", "version": "0.4"},
    {"name": "regex", "version": "1.10"},
    {"name": "serde", "version": "1.0"},
    {"name": "serde_json", "version": "1.0"},
    {"name": "serde_yaml", "version": "0.9"},
    {"name": "tokio", "version": "1.0"}
  ],
  "skill_dir": ".agents/skills/daily-digest",
  "source_files": [
    "src/noise_filter.rs",
    "src/digest_generator.rs",
    "src/markdown_renderer.rs",
    "src/vault_sync.rs",
    "src/lib.rs"
  ],
  "test_files": [
    "tests/digest_generator_tests.rs"
  ],
  "entry_points": {
    "primary": "load_skill",
    "auto_hooks": ["PreToolUse", "PostToolUse"],
    "public_api": [
      "init_skill",
      "load_config",
      "DailyDigestSkill"
    ]
  },
  "rust_settings": {
    "edition": "2021",
    "crate_type": ["cdylib", "rlib"],
    "opt_level": 1,
    "lto": false,
    "codegen_units": 16
  },
  "documentation": {
    "readme": "README.md",
    "api_docs": true,
    "examples": true
  },
  "capabilities": {
    "daily_digest_generation": true,
    "obsidian_vault_sync": true,
    "noise_filtering": true,
    "decision_extraction": true,
    "action_item_tracking": true,
    "code_snippet_extraction": true,
    "markdown_rendering": true,
    "utf8_lf_compliance": true
  },
  "integration_points": {
    "session_discovery": true,
    "load_skill_support": true,
    "hooks_support": ["PreToolUse", "PostToolUse"],
    "buzz_agent_core": true
  }
}
