{
  "name": "qa-guard",
  "version": "1.0.0",
  "description": "Git Patch 自動語法、編碼與執行預檢，杜絕補丁駁回、Mojibake 編碼問題與語法錯誤",
  "author": "Honey2",
  "tags": ["qa", "guard", "patch", "syntax", "encoding", "automation"],
  "status": "draft",
  "created": "2026-11-02",
  "dependencies": [
    {"name": "buzz-agent", "version": "*", "path": "../../../crates/buzz-agent"},
    {"name": "buzz-core", "version": "*", "path": "../../../crates/buzz-core"},
    {"name": "anyhow", "version": "1.0"},
    {"name": "serde", "version": "1.0"},
    {"name": "serde_json", "version": "1.0"},
    {"name": "serde_yaml", "version": "0.9"},
    {"name": "tokio", "version": "1.0"},
    {"name": "regex", "version": "1.10"}
  ],
  "skill_dir": ".agents/skills/qa-guard",
  "source_files": [
    "src/patch_parser.rs",
    "src/encoding_validator.rs",
    "src/syntax_checker.rs",
    "src/cargo_check_runner.rs",
    "src/report_generator.rs",
    "src/lib.rs"
  ],
  "test_files": [
    "tests/patch_parser_tests.rs",
    "tests/syntax_checker_tests.rs",
    "tests/encoding_validator_tests.rs"
  ],
  "entry_points": {
    "primary": "load_skill",
    "auto_hooks": ["PostToolUse"],
    "public_api": [
      "init_skill",
      "load_config",
      "QaGuardSkill"
    ]
  },
  "rust_settings": {
    "edition": "2021",
    "crate_type": ["cdylib", "rlib"],
    "opt_level": 1,
    "lto": false,
    "codegen_units": 16
  },
  "documentation": {
    "readme": "README.md",
    "api_docs": true,
    "examples": true
  },
  "capabilities": {
    "patch_parsing": true,
    "encoding_validation": true,
    "syntax_checking": true,
    "cargo_check": true,
    "report_generation": true,
    "utf8_lf_compliance": true,
    "rust_syntax_check": true,
    "multi_language_support": true
  },
  "integration_points": {
    "session_discovery": true,
    "load_skill_support": true,
    "hooks_support": ["PostToolUse"],
    "buzz_agent_core": true,
    "cli_integration": true
  }
}
