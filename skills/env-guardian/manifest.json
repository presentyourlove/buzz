{
  "name": "env-guardian",
  "version": "1.0.0",
  "description": "环境变量检查与依赖工具管理技能 - 确保系统环境安全完整，依赖工具正常运行",
  "author": "Pollen",
  "license": "MIT",
  "entry": "main.rs",
  "capabilities": [
    "environment_checking",
    "dependency_tool_monitoring",
    "service_health_monitoring",
    "circuit_breaker_protection"
  ],
  "dependencies": {
    "serde": "^1.0",
    "serde_json": "^1.0",
    "chrono": "^0.4"
  },
  "config_schema": {
    "check_environment": {
      "type": "object",
      "description": "环境检查配置",
      "properties": {
        "check_sensitive": {
          "type": "boolean",
          "description": "是否检查敏感变量",
          "default": true
        },
        "check_required": {
          "type": "boolean", 
          "description": "是否检查必需变量",
          "default": true
        },
        "check_security_policies": {
          "type": "boolean",
          "description": "是否检查安全策略",
          "default": true
        }
      }
    },
    "dependency_tools": {
      "type": "array",
      "description": "需要检查的依赖工具列表",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "min_version": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "service_health": {
      "type": "object",
      "description": "服务健康检查配置",
      "properties": {
        "check_network_services": {
          "type": "boolean",
          "description": "是否检查网络服务",
          "default": true
        },
        "check_process_status": {
          "type": "boolean",
          "description": "是否检查进程状态",
          "default": true
        },
        "check_resource_usage": {
          "type": "boolean",
          "description": "是否检查资源使用情况",
          "default": true
        }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "description": "熔断器配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否启用熔断保护",
          "default": true
        },
        "failure_threshold": {
          "type": "integer",
          "description": "失败次数阈值",
          "default": 5
        },
        "recovery_timeout": {
          "type": "integer",
          "description": "恢复等待时间（毫秒）",
          "default": 60000
        }
      }
    }
  },
  "hooks": {
    "on_environment_check": "check_and_report",
    "on_dependency_tool_check": "monitor_and_maintain",
    "on_service_health_check": "probe_and_maintain",
    "on_circuit_breaker_trigger": "activate_protection"
  }
}
