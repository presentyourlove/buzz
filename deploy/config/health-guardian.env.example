# System Health Guardian Configuration
# Copy to /etc/buzz-agent/health-guardian.env and customize

# =============================================================================
# REQUIRED: Enable Health Guardian
# =============================================================================
BUZZ_HEALTH_GUARDIAN_ENABLED=1

# =============================================================================
# REQUIRED: Channel for Health Alerts (Nostr channel UUID)
# =============================================================================
BUZZ_HEALTH_GUARDIAN_CHANNEL=5ca019f6-1a27-592a-b015-4baf0eb33572

# =============================================================================
# OPTIONAL: Cron Schedules (standard cron expressions)
# =============================================================================
# Regular health check: every 15 minutes (default)
BUZZ_HEALTH_GUARDIAN_SCHEDULE=*/15 * * * *

# Deep health check: daily at 4 AM UTC (default)
BUZZ_HEALTH_GUARDIAN_DAILY_DEEP=0 4 * * *

# Examples:
# Every 5 minutes: */5 * * * *
# Every hour at minute 0: 0 * * * *
# Weekdays 9 AM - 5 PM every 30 min: */30 9-17 * * 1-5
# Daily at 3:30 AM: 30 3 * * *

# =============================================================================
# OPTIONAL: Paths
# =============================================================================
BUZZ_WORK_LOGS_PATH=/opt/buzz-agent/.buzz/WORK_LOGS
BUZZ_CIRCUIT_BREAKER_PATH=/opt/buzz-agent/.buzz/WORK_LOGS/circuit_breaker.json
BUZZ_SYNC_PID_FILE=/opt/buzz-agent/.buzz/sync_obsidian.pid

# =============================================================================
# OPTIONAL: Monitored Service Ports
# =============================================================================
BUZZ_OPENROUTER_PORT=8080
BUZZ_PROXY_PORT=3000

# =============================================================================
# OPTIONAL: Alert Thresholds
# =============================================================================
# Send alert after N consecutive failures (default: 3)
BUZZ_HEALTH_MAX_CONSECUTIVE_FAILURES=3

# Auto-reset circuit breaker after recovery (default: true)
BUZZ_HEALTH_CB_AUTO_RESET=true

# Cooldown between process restarts in seconds (default: 300)
BUZZ_HEALTH_RESTART_COOLDOWN=300
