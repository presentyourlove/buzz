# Buzz Agent Core Configuration
# Copy to /etc/buzz-agent/buzz-agent.env and customize

# =============================================================================
# REQUIRED: Provider Selection (choose one)
# =============================================================================
# BUZZ_AGENT_PROVIDER=anthropic
# BUZZ_AGENT_PROVIDER=openai
# BUZZ_AGENT_PROVIDER=databricks
# BUZZ_AGENT_PROVIDER=databricks_v2
# BUZZ_AGENT_PROVIDER=openrouter

# =============================================================================
# REQUIRED: API Keys (per provider)
# =============================================================================
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# OpenAI / OpenAI-compatible
# OPENAI_COMPAT_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API=auto  # auto|chat|responses

# Databricks (legacy)
# DATABRICKS_HOST=your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=  # optional, for static token auth
# DATABRICKS_MODEL=databricks-meta-llama-3-1-70b-instruct

# Databricks v2 (AI Gateway)
# DATABRICKS_HOST=your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=  # optional
# DATABRICKS_MODEL=databricks-gpt-5-5

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# =============================================================================
# OPTIONAL: Model Override (universal, takes priority over provider-specific)
# =============================================================================
# BUZZ_AGENT_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# OPTIONAL: Agent Identity (for Mode B daemon)
# =============================================================================
# BUZZ_PRIVATE_KEY=  # hex or nsec - agent's Nostr private key
# BUZZ_RELAY_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: Agent Configuration
# =============================================================================
# BUZZ_AGENT_SYSTEM_PROMPT="You are buzz-agent..."
# BUZZ_AGENT_SYSTEM_PROMPT_FILE=/etc/buzz-agent/system-prompt.md
# BUZZ_AGENT_MAX_ROUNDS=0
# BUZZ_AGENT_MAX_OUTPUT_TOKENS=65536
# BUZZ_AGENT_MAX_TOKEN_RECOVERIES=3
# BUZZ_AGENT_LLM_TIMEOUT_SECS=240
# BUZZ_AGENT_TOOL_TIMEOUT_SECS=1260
# BUZZ_AGENT_MCP_INIT_TIMEOUT_SECS=30
# BUZZ_AGENT_MCP_RESTART_MAX_ATTEMPTS=3
# BUZZ_AGENT_MCP_RESTART_BASE_MS=500
# BUZZ_AGENT_MCP_RESTART_MAX_MS=30000
# BUZZ_AGENT_MAX_SESSIONS=100
# BUZZ_AGENT_MAX_LINE_BYTES=4194304

# =============================================================================
# OPTIONAL: Thinking/Reasoning Configuration
# =============================================================================
# BUZZ_AGENT_THINKING_EFFORT=medium  # none|minimal|low|medium|high|xhigh|max
# BUZZ_AGENT_THINKING_SUMMARY=auto  # auto|concise|detailed

# =============================================================================
# OPTIONAL: Databricks Model Filter
# =============================================================================
# DATABRICKS_MODEL_FILTER=databricks-*,gpt-*

# =============================================================================
# OPTIONAL: Hints & Skills
# =============================================================================
# BUZZ_AGENT_HINTS_ENABLED=true
# BUZZ_AGENT_HISTORY_CACHE_TTL_SECS=3600
# BUZZ_AGENT_HISTORY_CACHE_MAX=10000
