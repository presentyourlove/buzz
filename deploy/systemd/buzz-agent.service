[Unit]
Description=Buzz Agent with System Health Guardian
Documentation=https://github.com/block/sprout
After=network-online.target
Wants=network-online.target

# Optional: Start after Redis if using daemon lock
# After=redis.service
# Wants=redis.service

[Service]
Type=notify
User=buzz
Group=buzz

# Working directory - adjust to your deployment path
WorkingDirectory=/opt/buzz-agent

# Environment file with all required variables
EnvironmentFile=-/etc/buzz-agent/buzz-agent.env
EnvironmentFile=-/etc/buzz-agent/health-guardian.env

# The buzz-agent binary (built from crates/buzz-agent)
ExecStart=/usr/local/bin/buzz-agent

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buzz-agent/.buzz /var/log/buzz-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buzz-agent

# Health check for systemd (optional - requires HTTP endpoint)
# ExecStartPre=/usr/local/bin/buzz-agent health-check --json

[Install]
WantedBy=multi-user.target
