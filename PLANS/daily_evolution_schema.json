{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://buzz.example.com/schemas/daily-evolution-proposal.json",
  "title": "Daily Evolution Proposal",
  "description": "Schema for daily evolution optimization proposals generated by Honey's Daily Evolution System",
  "type": "object",
  "required": [
    "template_version",
    "channel_id",
    "date",
    "daily_summary",
    "action_items",
    "blockers",
    "decisions",
    "work_logs_summary",
    "recommendations",
    "approval",
    "metadata"
  ],
  "properties": {
    "template_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Template version (semver major.minor)"
    },
    "channel_id": {
      "type": "string",
      "format": "uuid",
      "description": "Channel UUID where proposal was generated"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Proposal date (YYYY-MM-DD)"
    },
    "daily_summary": {
      "type": "object",
      "required": ["message_count", "participant_count", "author_activity", "topics"],
      "properties": {
        "message_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total messages analyzed"
        },
        "participant_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unique participants"
        },
        "author_activity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["author_prefix", "message_count", "percentage"],
            "properties": {
              "author_prefix": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$",
                "description": "First 16 chars of author pubkey"
              },
              "message_count": {
                "type": "integer",
                "minimum": 1
              },
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "description": "Author activity ranked by message count"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bugs/errors",
              "feature development",
              "code review",
              "deployment",
              "testing",
              "refactoring"
            ]
          },
          "description": "Technical topics detected in conversations"
        },
        "analysis_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When analysis was performed (UTC)"
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "source_message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "Item ID (category.number)"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "source_message": {
            "type": "string",
            "maxLength": 200,
            "description": "Excerpt from original message"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "default": "medium"
          }
        }
      },
      "maxItems": 20,
      "description": "Action items extracted from conversations"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "source_message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "source_message": {
            "type": "string",
            "maxLength": 200
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium"],
            "default": "high"
          }
        }
      },
      "maxItems": 10,
      "description": "Blockers identified in conversations"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "source_message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "source_message": {
            "type": "string",
            "maxLength": 200
          },
          "consensus": {
            "type": "boolean",
            "default": false,
            "description": "Whether explicit consensus was reached"
          }
        }
      },
      "maxItems": 10,
      "description": "Decisions made during the day"
    },
    "work_logs_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "excerpt", "modified_at"],
        "properties": {
          "file": {
            "type": "string"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 300
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Summary of work log files from WORK_LOGS/"
    },
    "recommendations": {
      "type": "object",
      "required": ["process_improvements", "technical_debt", "team_coordination", "automation_opportunities"],
      "properties": {
        "process_improvements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^1\\.\\d+$" },
              "description": { "type": "string", "maxLength": 200 },
              "source": { "type": "string", "enum": ["template", "conversation"], "description": "Template default or conversation-derived" },
              "checked": { "type": "boolean", "default": false }
            }
          }
        },
        "technical_debt": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^2\\.\\d+$" },
              "description": { "type": "string", "maxLength": 200 },
              "source": { "type": "string", "enum": ["template", "conversation"] },
              "checked": { "type": "boolean", "default": false }
            }
          }
        },
        "team_coordination": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^3\\.\\d+$" },
              "description": { "type": "string", "maxLength": 200 },
              "source": { "type": "string", "enum": ["template", "conversation"] },
              "checked": { "type": "boolean", "default": false }
            }
          }
        },
        "automation_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^4\\.\\d+$" },
              "description": { "type": "string", "maxLength": 200 },
              "source": { "type": "string", "enum": ["template", "conversation"] },
              "checked": { "type": "boolean", "default": false }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["required", "options", "tracking"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["response", "action"],
            "properties": {
              "response": { "type": "string" },
              "action": { "type": "string" }
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "tracking": {
          "type": "object",
          "required": ["log_file", "columns"],
          "properties": {
            "log_file": { "type": "string", "pattern": "^OUTBOX/IMPLEMENTATION_LOG_\\d{8}\\.md$" },
            "columns": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "generated_at",
        "script_version",
        "action_items_count",
        "blockers_count",
        "decisions_count",
        "work_logs_count"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "script_version": { "type": "string" },
        "action_items_count": { "type": "integer", "minimum": 0 },
        "blockers_count": { "type": "integer", "minimum": 0 },
        "decisions_count": { "type": "integer", "minimum": 0 },
        "work_logs_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "additionalProperties": false
}
